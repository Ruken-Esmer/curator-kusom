# Application
APP_ENV=development            # development | production (demo endpoints are disabled in production)
APP_DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173"]

# LLM (optional; without a key CURATOR chat runs in offline extractive mode)
ACTIVE_LLM=anthropic           # anthropic | openai | offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=

# Neo4j (optional for MİMAR; the concept graph is computed in Python and
#    can be pushed to Neo4j from the API)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=curator_password
NEO4J_DATABASE=neo4j

# MİMAR research store (local, on-premises SQLite; never a cloud service)
MIMAR_DB_PATH=data/mimar/mimar.sqlite3
MIMAR_ADMIN_TOKEN=change-me-to-a-long-random-secret
# MIMAR_ENABLE_DEMO=1          # allow the synthetic demo outside development
